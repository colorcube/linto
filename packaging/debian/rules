#!/usr/bin/make -f

export PYBUILD_NAME=linto
export PYBUILD_DESTDIR=debian/linto

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	desktop-file-validate src/linto/resources/desktop/de.colorcube.linto.desktop
	appstreamcli validate --no-net src/linto/resources/desktop/de.colorcube.linto.metainfo.xml
	QT_QPA_PLATFORM=offscreen PYTHONPATH=$(CURDIR)/src python3 -m pytest -q -p no:cacheprovider tests

override_dh_auto_install:
	dh_auto_install
	install -Dm 0644 src/linto/resources/desktop/de.colorcube.linto.desktop \
		debian/linto/usr/share/applications/de.colorcube.linto.desktop
	install -Dm 0644 src/linto/resources/desktop/de.colorcube.linto.metainfo.xml \
		debian/linto/usr/share/metainfo/de.colorcube.linto.metainfo.xml
	install -Dm 0644 src/linto/resources/icons/linto.svg \
		debian/linto/usr/share/icons/hicolor/scalable/apps/de.colorcube.linto.svg
